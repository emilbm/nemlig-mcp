# The Nemlig account this server shops on behalf of. A client may override these
# per request with X-Nemlig-Username / X-Nemlig-Password headers; leave them
# unset to make the server header-only.
NEMLIG_USERNAME=you@example.com
NEMLIG_PASSWORD=your-nemlig-password

# Set to false to disable the header override and pin the server to one account.
#NEMLIG_ALLOW_HEADER_CREDENTIALS=true

# Logging in drives a headless Chromium. If Nemlig starts refusing the headless
# browser, run this on a host with a display and set NEMLIG_HEADLESS=false.
#NEMLIG_HEADLESS=true
#NEMLIG_LOGIN_TIMEOUT_MS=60000

# How long an unused session keeps its token before the next call logs in again.
#NEMLIG_SESSION_TTL_MS=604800000

# Opaque segment Nemlig bakes into its frontend build; only matters if the
# favourites endpoint starts returning 404.
#NEMLIG_FAVOURITES_GROUP_ID=10040a7d-a9ed-4f0e-b1a2-0febd90427c1

#PORT=8080
#LOG_LEVEL=info
